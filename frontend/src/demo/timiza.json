   {
    "slug": "timiza",
    "tagline": "Empowering communities, transforming lives",
    "intro": "We are a community-based organization in Kilifi, Kenya, advocating for health, gender, peace and security, climate action and disability inclusion for a healthy and safe Kilifi County.",
    "about": "We work through young people: peer educators, ward dialogues, school clubs and volunteers who know their communities. We champion comprehensive sexual health education, work against gender-based violence, plant and protect indigenous trees, and push for public spaces everyone can use.",
    "location": "Kilifi County, Kenya",
    "contact_email": "youthtimiza@gmail.com",
    "phone": "",
    "facebook": "Timiza Youth Initiative",
